# 이 파일은 예시입니다. 비밀번호, access key, 실제 계정 ID를 넣지 마세요.
# 필요한 개인 설정은 terraform.tfvars (Git ignore 대상) 또는 환경 변수로 전달하세요.

aws_region = "ap-northeast-2"

# 아래 2개는 형식 예시입니다. 적용 전 팀에서 실제로 사용하는 IAM 역할 ARN이나
# IAM 사용자 ARN으로 바꾸세요. 권한 정책 ARN은 필요한 범위만 선택하세요.
operator_access_entries = {
  kubernetes_operator_1 = {
    principal_arn = "arn:aws:iam::<ACCOUNT_ID>:role/<TEAM_OPERATOR_ROLE_1>"
    policy_arn    = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
    scope_type    = "cluster"
    run_as_user   = "sai-operator-1"
  }
  kubernetes_operator_2 = {
    principal_arn = "arn:aws:iam::<ACCOUNT_ID>:role/<TEAM_OPERATOR_ROLE_2>"
    policy_arn    = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
    scope_type    = "cluster"
    run_as_user   = "sai-operator-2"
  }
}
