# 이 파일은 예시입니다. 비밀번호, access key, 실제 계정 ID를 넣지 마세요.
# 필요한 개인 설정은 terraform.tfvars (Git ignore 대상) 또는 환경 변수로 전달하세요.

aws_region = "ap-northeast-2"

# 실제 팀 IAM Identity Center 역할 ARN과 권한 정책 ARN으로 채웁니다.
