# DB 초기화 Job 설정 예시. 복사해서 db-init.env 로 만들고 값을 채운다. (db-init.env는 Git 제외)
# kind:  DB_HOST=mariadb, DB_ADMIN_USER=root, DB_ADMIN_PASSWORD=local-db.env의 MARIADB_ROOT_PASSWORD
# AWS:   DB_HOST=terraform output rds_endpoint, 관리자 계정은 RDS master secret에서 꺼냄 (README)
DB_HOST=
DB_PORT=3306
DB_NAME=sai
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
APP_DB_USER=sai_app
# 영문·숫자 16자 이상. 만들기: openssl rand -hex 16
APP_DB_PASSWORD=
# 필요할 때만 (예: TLS 인증서 옵션)
DB_CLIENT_OPTS=