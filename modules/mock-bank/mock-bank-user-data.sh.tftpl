#!/bin/bash
set -euo pipefail
umask 077

dnf install -y docker nginx curl python3 awscli-2 xfsprogs
systemctl enable --now docker

install -d -m 0700 /opt/sai-mock-bank
install -d -m 0700 /etc/sai-mock-bank/tls
install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl --fail --silent --show-error --location \
  "https://github.com/docker/compose/releases/download/${docker_compose_version}/docker-compose-linux-x86_64" \
  --output /usr/local/lib/docker/cli-plugins/docker-compose
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose

# EBS 볼륨은 인스턴스와 별도로 생성하며, 기존 파일시스템이 있을 때는 포맷하지 않습니다.
DATABASE_VOLUME_ID="${database_volume_id}"
DATABASE_DEVICE_ID="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${DATABASE_VOLUME_ID//-/}"
for attempt in $(seq 1 120); do
  if [ -b "$DATABASE_DEVICE_ID" ]; then
    break
  fi
  sleep 5
done
if [ ! -b "$DATABASE_DEVICE_ID" ]; then
  echo "Mock Bank database EBS device did not appear." >&2
  exit 1
fi
if ! blkid "$DATABASE_DEVICE_ID" >/dev/null 2>&1; then
  mkfs.xfs -f "$DATABASE_DEVICE_ID"
fi
DATABASE_FILESYSTEM_UUID="$(blkid -s UUID -o value "$DATABASE_DEVICE_ID")"
install -d -m 0750 /mnt/mock-bank-database
if ! grep -q "UUID=$DATABASE_FILESYSTEM_UUID[[:space:]]" /etc/fstab; then
  printf 'UUID=%s /mnt/mock-bank-database xfs defaults,nofail 0 2\n' \
    "$DATABASE_FILESYSTEM_UUID" >> /etc/fstab
fi
mount /mnt/mock-bank-database
chown 999:999 /mnt/mock-bank-database
chmod 0750 /mnt/mock-bank-database

AWS_REGION="${aws_region}"
APP_SECRET_ARN="${mock_bank_secret_arn}"
TLS_SECRET_ARN="${mock_bank_api_certificate_secret_arn}"
IMAGE_URI="${mock_bank_image}"
ECR_REGISTRY="$${IMAGE_URI%%/*}"

aws ecr get-login-password --region "$AWS_REGION" \
  | docker login --username AWS --password-stdin "$ECR_REGISTRY"
trap 'docker logout "$ECR_REGISTRY" >/dev/null 2>&1 || true' EXIT

# secret value는 Terraform user_data/state에 넣지 않습니다. 부팅 시 메모리에서 읽고 root 전용 파일로 씁니다.
APP_SECRET_JSON="$(aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$APP_SECRET_ARN" \
  --query SecretString \
  --output text)"
TLS_SECRET_JSON="$(aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$TLS_SECRET_ARN" \
  --query SecretString \
  --output text)"
export APP_SECRET_JSON TLS_SECRET_JSON

python3 - <<'PY'
import json
import os
import re
from pathlib import Path

required = {
    "DB_NAME", "DB_USERNAME", "DB_PASSWORD", "DB_ROOT_PASSWORD",
    "MOCK_BANK_KEY_HASH_SECRET", "JWT_SECRET", "LINK_IDENTITY_HASH_SECRET",
    "LINK_STATE_SECRET", "LINK_CALLBACK_API_KEY", "PORTONE_IDENTITY_STORE_ID",
    "PORTONE_IDENTITY_CHANNEL_KEY", "PORTONE_IDENTITY_API_SECRET",
    "SAI_BACKEND_BASE_URL", "SAI_BACKEND_CALLBACK_URL",
}
settings = json.loads(os.environ["APP_SECRET_JSON"])
missing = required.difference(settings)
if missing:
    raise SystemExit("Required Mock Bank application settings are missing from Secrets Manager.")

dotenv = Path("/opt/sai-mock-bank/.env")
with dotenv.open("w", encoding="utf-8") as env_file:
    for key, value in settings.items():
        if not re.fullmatch(r"[A-Z0-9_]+", key):
            raise SystemExit("Invalid environment variable name in Mock Bank secret.")
        value = str(value).replace("\\", "\\\\").replace("'", "\\'").replace("\r", "\\r").replace("\n", "\\n")
        env_file.write(f"{key}='{value}'\n")

tls = json.loads(os.environ["TLS_SECRET_JSON"])
if not tls.get("TLS_CERTIFICATE_PEM", "").startswith("-----BEGIN CERTIFICATE-----"):
    raise SystemExit("TLS certificate secret must contain a PEM certificate chain.")
if "-----BEGIN " not in tls.get("TLS_PRIVATE_KEY_PEM", "") or "PRIVATE KEY-----" not in tls["TLS_PRIVATE_KEY_PEM"]:
    raise SystemExit("TLS certificate secret must contain a PEM private key.")

certificate = Path("/etc/sai-mock-bank/tls/fullchain.pem")
private_key = Path("/etc/sai-mock-bank/tls/private-key.pem")
certificate.write_text(tls["TLS_CERTIFICATE_PEM"], encoding="utf-8")
private_key.write_text(tls["TLS_PRIVATE_KEY_PEM"], encoding="utf-8")
certificate.chmod(0o600)
private_key.chmod(0o600)
PY
unset APP_SECRET_JSON TLS_SECRET_JSON
chmod 0600 /opt/sai-mock-bank/.env
printf 'MOCK_BANK_APP_PORT=%s\n' "${mock_bank_app_port}" >> /opt/sai-mock-bank/.env
printf 'MOCK_BANK_ORIGIN_PORT=%s\n' "${mock_bank_origin_port}" >> /opt/sai-mock-bank/.env
printf 'MOCK_BANK_API_PORT=%s\n' "${mock_bank_api_port}" >> /opt/sai-mock-bank/.env

cat > /opt/sai-mock-bank/compose.yaml <<'COMPOSE'
services:
  mock-bank-db:
    image: mariadb:11.4
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: $${DB_NAME}
      MARIADB_USER: $${DB_USERNAME}
      MARIADB_PASSWORD: $${DB_PASSWORD}
      MARIADB_ROOT_PASSWORD: $${DB_ROOT_PASSWORD}
    volumes:
      - /mnt/mock-bank-database:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  mock-bank-app:
    image: "${mock_bank_image}"
    restart: unless-stopped
    depends_on:
      mock-bank-db:
        condition: service_healthy
    environment:
      SPRING_PROFILES_ACTIVE: prod
      SERVER_PORT: $${MOCK_BANK_APP_PORT}
      SERVER_FORWARD_HEADERS_STRATEGY: framework
      SERVER_SERVLET_SESSION_COOKIE_SECURE: "true"
      SERVER_SERVLET_SESSION_COOKIE_HTTP_ONLY: "true"
      SPRING_DATASOURCE_URL: "jdbc:mariadb://mock-bank-db:3306/$${DB_NAME}"
      SPRING_DATASOURCE_USERNAME: $${DB_USERNAME}
      SPRING_DATASOURCE_PASSWORD: $${DB_PASSWORD}
      MOCK_BANK_KEY_HASH_SECRET: $${MOCK_BANK_KEY_HASH_SECRET}
      JWT_SECRET: $${JWT_SECRET}
      LINK_IDENTITY_HASH_SECRET: $${LINK_IDENTITY_HASH_SECRET}
      LINK_STATE_SECRET: $${LINK_STATE_SECRET}
      LINK_STATE_ALLOWED_RETURN_URLS: $${SAI_BACKEND_CALLBACK_URL}
      LINK_CALLBACK_API_KEY: $${LINK_CALLBACK_API_KEY}
      PORTONE_IDENTITY_STORE_ID: $${PORTONE_IDENTITY_STORE_ID}
      PORTONE_IDENTITY_CHANNEL_KEY: $${PORTONE_IDENTITY_CHANNEL_KEY}
      PORTONE_IDENTITY_API_SECRET: $${PORTONE_IDENTITY_API_SECRET}
      SAI_BACKEND_BASE_URL: $${SAI_BACKEND_BASE_URL}
    ports:
      - "127.0.0.1:$${MOCK_BANK_APP_PORT}:$${MOCK_BANK_APP_PORT}"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
COMPOSE

cat > /etc/nginx/conf.d/sai-mock-bank.conf <<'NGINX'
${nginx_config}
NGINX
rm -f /etc/nginx/conf.d/default.conf
nginx -t
systemctl enable --now nginx

cd /opt/sai-mock-bank
docker compose pull
docker compose up --detach
