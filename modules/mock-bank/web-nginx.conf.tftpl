# CloudFront VPC Origin only. Public browser traffic is proxied to the private WAS tier.
server {
  listen ${origin_port} default_server;
  server_name _;

  client_max_body_size 2m;
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

  # Allow only the API paths used by the browser UI. Private backend callbacks
  # and any new API route remain inaccessible through this listener by default.
  location ~ ^/api/(?:auth/(?:signup|login)|link/confirm|mock-bank/(?:accounts|transfers))/?$ {
    limit_except POST { deny all; }
    proxy_pass http://${was_private_ip}:${was_app_port};
  }

  location = /api/users/me {
    limit_except GET DELETE { deny all; }
    proxy_pass http://${was_private_ip}:${was_app_port};
  }

  location ~ ^/api/(?:linked-accounts|bank-user/accounts|mock-bank/(?:accounts/my(?:/(?:transactions|[0-9]+/transactions))?|customer-accounts/lookup|transfers/[0-9]+))/?$ {
    limit_except GET { deny all; }
    proxy_pass http://${was_private_ip}:${was_app_port};
  }

  # Match the API prefix case-insensitively so variants cannot fall through to the general proxy.
  location ~* ^/api(?:/|$) { return 404; }

  location / {
    proxy_pass http://${was_private_ip}:${was_app_port};
  }
}
