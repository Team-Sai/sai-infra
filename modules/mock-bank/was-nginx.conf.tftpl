# SAI backend-only TLS API. The WAS SG and VPC peering limit the source network.
server {
  listen ${api_port} ssl default_server;
  server_name ${api_hostname};

  ssl_certificate     /etc/sai-mock-bank/tls/fullchain.pem;
  ssl_certificate_key /etc/sai-mock-bank/tls/private-key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;

  location ~ ^/api/mock-bank/link/?$ {
    limit_except POST { deny all; }
    proxy_pass http://${was_private_ip}:${app_port};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${api_hostname};
    proxy_set_header X-Forwarded-Host ${api_hostname};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location ~ ^/api/link/(confirm-key|revoke-key|recover-key)/?$ {
    limit_except POST { deny all; }
    proxy_pass http://${was_private_ip}:${app_port};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${api_hostname};
    proxy_set_header X-Forwarded-Host ${api_hostname};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location = /api/mock-bank/accounts {
    limit_except GET { deny all; }
    proxy_pass http://${was_private_ip}:${app_port};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${api_hostname};
    proxy_set_header X-Forwarded-Host ${api_hostname};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location ~ ^/api/mock-bank/accounts/[0-9]+(/transactions)?/?$ {
    limit_except GET { deny all; }
    proxy_pass http://${was_private_ip}:${app_port};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ${api_hostname};
    proxy_set_header X-Forwarded-Host ${api_hostname};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / { return 404; }
}
